CONFIG_TARGET_bcm53xx=y
CONFIG_TARGET_bcm53xx_DEVICE_phicomm_k3=y
CONFIG_BUILD_PATENTED=y

# K3无线固件
CONFIG_PACKAGE_k3-brcmfmac4366c-firmware=y

# 博通交换机、网口驱动
CONFIG_PACKAGE_kmod-bcm53xx-switch=y
CONFIG_PACKAGE_kmod-swconfig=y
CONFIG_PACKAGE_swconfig=y

# LAN/VLAN端口网页设置
CONFIG_PACKAGE_luci-app-network-switch=y

#基础LuCI网页
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

#网络组件
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# TUN 内核模块(Docker/VPN必备)
CONFIG_PACKAGE_kmod-tun=y
CONFIG_KERNEL_TUN=y

# EXT4 安全选项（Docker overlay2必需）
CONFIG_KERNEL_EXT4_FS_SECURITY=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y

# ========== U盘/硬盘 USB全套支持（K3自带USB3.0） ==========
# USB控制器驱动
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# 文件系统支持 NTFS/FAT32/EXFAT
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_ntfs3progs=y

# LuCI网页挂载管理（网页直接挂载U盘）
CONFIG_PACKAGE_luci-app-mountd=y
CONFIG_PACKAGE_mountd=y
CONFIG_PACKAGE_usbutils=y
